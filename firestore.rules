rules_version = '2';

// Читать могут все (родители по ссылке, без входа).
// Писать могут только пользователи, чей UID есть в коллекции `admins`
// (тренер и второй админ). Список админов меняется только в Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.status in ['groups', 'playoff', 'finished'];
      allow delete: if isAdmin();
    }

    // всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
